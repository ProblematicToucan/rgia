---
---

<section class="help-cta-section" id="contact">
  <div class="container">
    <div class="help-cta-content">
      <h2 class="help-title">How can we help?</h2>
      <p class="help-desc">
        Connect with our technology consultants to explore how RGIA can support your digital initiatives,
        augment your engineering team, or accelerate custom software delivery.
      </p>

      <div class="help-cards-grid">
        <!-- Direct Inquiries -->
        <div class="help-box">
          <div class="help-box-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <h3 class="help-box-title">Email our team</h3>
          <p class="help-box-desc">Send us your project brief or inquiry and a solutions director will respond within 24 hours.</p>
          <a href="mailto:info@ruanggeneratif.com" class="btn-white">
            <span>info@ruanggeneratif.com</span>
          </a>
        </div>

        <!-- WhatsApp / Quick Call -->
        <div class="help-box">
          <div class="help-box-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <h3 class="help-box-title">Direct WhatsApp / Phone</h3>
          <p class="help-box-desc">Speak directly with our client engagement lead regarding urgent enterprise requirements.</p>
          <a href="https://wa.me/6282311460366" target="_blank" rel="noopener noreferrer" class="btn-primary">
            <span>+62 823 1146 0366</span>
          </a>
        </div>

        <!-- Office Location -->
        <div class="help-box">
          <div class="help-box-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <h3 class="help-box-title">Jakarta Delivery Centre</h3>
          <p class="help-box-desc">
            MTH Square Ground Floor (GF) A4 A, Jl. Letjen M.T. Haryono Kav. 10, Bidara Cina, Jatinegara, Jakarta Timur.
          </p>
          <span class="office-tag">Headquarters</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .help-cta-section {
    background-color: var(--color-bg-dark);
    padding: 80px 0;
    color: #ffffff;
  }

  .help-cta-content {
    max-width: 1100px;
    margin: 0 auto;
  }

  .help-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }

  .help-desc {
    font-size: 1.15rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    max-width: 720px;
    margin-bottom: 48px;
  }

  .help-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .help-box {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .help-box:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .help-box-icon {
    color: var(--color-brand-accent);
    margin-bottom: 16px;
  }

  .help-box-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 10px;
  }

  .help-box-desc {
    font-size: 0.925rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 24px;
    flex-grow: 1;
  }

  .office-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-brand-accent);
    background: rgba(227, 25, 55, 0.15);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    width: fit-content;
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .help-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
