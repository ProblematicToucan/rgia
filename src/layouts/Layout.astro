---
import { ClientRouter } from 'astro:transitions';
import { Copilot } from '../components/Copilot';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = "PT Ruang Generatif Indonesia (RGIA) | AI & Enterprise Software Engineering",
  description = "PT Ruang Generatif Indonesia delivers custom AI components, enterprise software platforms, cybersecurity advisory, and managed engineering squads across Indonesia.",
  currentPath = Astro.url.pathname
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="PT Ruang Generatif Indonesia" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <ClientRouter />
  </head>
  <body>
    <Navbar currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <Copilot client:load transition:persist="copilot" />
  </body>
</html>

<style is:global>
  #main-content {
    flex: 1 0 auto;
    width: 100%;
  }
</style>
